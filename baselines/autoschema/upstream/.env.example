# Required: Azure OpenAI chat deployment
AZURE_OPENAI_CHAT_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_CHAT_API_KEY=replace_with_your_key
AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=replace_with_your_chat_deployment

# Required: Azure OpenAI embedding deployment
AZURE_OPENAI_EMBED_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_EMBED_API_KEY=replace_with_your_key
AZURE_OPENAI_EMBED_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large

# Keep this legacy alias equal to AZURE_OPENAI_EMBED_DEPLOYMENT.
# Phase1/queries_generation.py currently reads this spelling.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Recommended contact emails for scholarly APIs
CROSSREF_MAILTO=anonymous@example.com
OPENALEX_MAILTO=anonymous@example.com
NCBI_EMAIL=anonymous@example.com

# Optional provider API keys; leave blank if unavailable
CORE_API_KEY=
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Optional debugging output directory. Normally set internally by Phase 1.
# AUTOSCHEMA_DEBUG_DIR=./debug/paper_level

# Optional: second judge for the cross-family evaluation (scripts/judge_crosscheck.py)
# JUDGE_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_key
GEMINI_JUDGE_MODEL=models/gemini-3.1-pro-preview
