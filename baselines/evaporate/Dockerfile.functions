FROM python:3.11-slim
RUN pip install --no-cache-dir numpy==1.26.4 pandas==2.2.3 beautifulsoup4==4.12.3 lxml==5.3.0
WORKDIR /app
COPY function_worker.py /app/function_worker.py
COPY full_upstream/profiler.py /app/full_upstream/profiler.py
ENV PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
ENTRYPOINT ["python", "/app/function_worker.py"]
